<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily Mathetes run. Install/uninstall instructions: deploy/README.md

  Paths must be absolute and must be updated if the repo moves.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andrewbrown.mathetes.daily</string>

    <!-- Invokes the venv interpreter directly on daily.py. Deliberately NOT
         `/bin/bash run_daily.sh`: the repo is under ~/Desktop, which macOS
         protects with TCC, and a LaunchAgent running /bin/bash is denied read
         access to files there — that form fails with "Operation not permitted"
         before the script starts. The venv interpreter is not denied.

         WorkingDirectory is deliberately omitted for the same reason: launchd
         chdir-ing into the protected path fails with "error retrieving current
         directory". daily.py sets its own cwd per step instead. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/andrewbrown/Desktop/mathetes/venv/bin/python</string>
        <string>/Users/andrewbrown/Desktop/mathetes/daily.py</string>
    </array>

    <!-- Once a day at 07:30 local. If the Mac is asleep at that moment,
         launchd runs the job shortly after it next wakes rather than skipping
         the day, which is the main reason this is a LaunchAgent and not cron. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Do not fire on every login/reload, only on the schedule above. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Both streams are appended, so a failure is still readable tomorrow.
         run_daily.sh prints a timestamped banner per run to delimit them. -->
    <key>StandardOutPath</key>
    <string>/Users/andrewbrown/Library/Logs/mathetes/daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/andrewbrown/Library/Logs/mathetes/daily.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
